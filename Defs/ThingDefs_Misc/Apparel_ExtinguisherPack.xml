<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef ParentName="ApparelNoQualityBase">
		<defName>Apparel_PackExtinguisher</defName>
		<label>extinguisher pack</label>
		<description>A high-tech wearable pack-station equipped with a built-in micro-fabricator that assembles extinguisher drones. Automatically deploys a drone when fire is detected near the wearer, and can also be launched manually to a target location. Reloaded with industrial components.</description>
		<graphicData>
			<texPath>HunterDronePack/Apparel_PackHunter_Extinguisher</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(0.7,0.7)</drawSize>
		</graphicData>
		<tickerType>Normal</tickerType>
		<techLevel>Spacer</techLevel>
		<statBases>
			<WorkToMake>24000</WorkToMake>
			<Mass>3.5</Mass>
			<Flammability>0.1</Flammability>
			<EquipDelay>2</EquipDelay>
		</statBases>
		<thingCategories>
			<li>ApparelUtility</li>
		</thingCategories>
		<thingSetMakerTags>
			<li>RewardStandardHighFreq</li>
		</thingSetMakerTags>
		<costList>
			<Plasteel>50</Plasteel>
			<Steel>40</Steel>
			<ComponentIndustrial>4</ComponentIndustrial>
			<ComponentSpacer>2</ComponentSpacer>
		</costList>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedPack</unfinishedThingDef>
			<researchPrerequisites>
				<li>Firefoam</li>
				<li>HunterDrones</li>
				<li>Fabrication</li>
			</researchPrerequisites>
			<recipeUsers>
				<li>FabricationBench</li>
			</recipeUsers>
			<useIngredientsForColor>false</useIngredientsForColor>
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<effectWorking>Smith</effectWorking>
			<soundWorking>Recipe_Machining</soundWorking>
			<displayPriority>365</displayPriority>
			<skillRequirements>
				<Crafting>10</Crafting>
			</skillRequirements>
		</recipeMaker>
		<mergeVerbGizmos>false</mergeVerbGizmos>
		<apparel>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<scoreOffset>4</scoreOffset>
			<careIfWornByCorpse>false</careIfWornByCorpse>
			<careIfDamaged>false</careIfDamaged>
			<wearPerDay>0</wearPerDay>
			<bodyPartGroups>
				<li>Waist</li>
			</bodyPartGroups>
			<layers>
				<li>Belt</li>
			</layers>
			<wornGraphicPath>HunterDronePack/Apparel_PackHunter_Extinguisher</wornGraphicPath>
			<wornGraphicData>
				<renderUtilityAsPack>true</renderUtilityAsPack>
				<north>
					<offset>(0,0)</offset>
				</north>
				<south>
					<offset>(0,0)</offset>
				</south>
				<east>
					<scale>(0.75,0.75)</scale>
					<offset>(-0.3,-0.05)</offset>
					<thin>
						<offset>(0.05,0)</offset>
					</thin>
					<hulk>
						<offset>(-0.1,0)</offset>
					</hulk>
					<fat>
						<offset>(-0.1,0)</offset>
					</fat>
				</east>
				<west>
					<scale>(0.75,0.75)</scale>
					<offset>(0.3,-0.05)</offset>
					<thin>
						<offset>(-0.05,0)</offset>
					</thin>
					<hulk>
						<offset>(0.1,0)</offset>
					</hulk>
					<fat>
						<offset>(0.1,0)</offset>
					</fat>
				</west>
				<male>
					<scale>(0.75,0.75)</scale>
				</male>
				<female>
					<scale>(0.7,0.7)</scale>
				</female>
				<thin>
					<scale>(0.7,0.7)</scale>
				</thin>
				<hulk>
					<scale>(0.9,0.85)</scale>
				</hulk>
				<fat>
					<scale>(0.8,0.8)</scale>
				</fat>
			</wornGraphicData>
		</apparel>
		<comps>
			<li Class="CompProperties_ApparelReloadable">
				<hotKey>Misc4</hotKey>
				<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
				<maxCharges>1</maxCharges>
				<ammoDef>ComponentIndustrial</ammoDef>
				<ammoCountPerCharge>4</ammoCountPerCharge>
				<destroyOnEmpty>false</destroyOnEmpty>
				<chargeNoun>drone</chargeNoun>
			</li>
			<li Class="ExtinguisherDronePack.CompProperties_AutoExtinguisherPack">
				<detectRadius>12.9</detectRadius>
				<checkInterval>60</checkInterval>
				<droneKind>Drone_FirefoamPopper</droneKind>
			</li>
		</comps>
		<verbs>
			<li>
				<verbClass>ExtinguisherDronePack.Verb_LaunchProjectileExtinguisherPack</verbClass>
				<label>deploy extinguisher drone</label>
				<defaultProjectile>Grenade_ExtinguisherPack</defaultProjectile>
				<warmupTime>1.0</warmupTime>
				<range>20.9</range>
				<burstShotCount>1</burstShotCount>
				<onlyManualCast>true</onlyManualCast>
				<hasStandardCommand>true</hasStandardCommand>
				<targetable>true</targetable>
				<targetParams>
					<canTargetPawns>false</canTargetPawns>
					<canTargetBuildings>false</canTargetBuildings>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<soundCast>ThrowGrenade</soundCast>
				<rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
				<canGoWild>false</canGoWild>
			</li>
		</verbs>
		<tradeTags>
			<li>Clothing</li>
			<li>ExoticMisc</li>
		</tradeTags>
		<allowedArchonexusCount>1</allowedArchonexusCount>
	</ThingDef>

	<ThingDef ParentName="BaseGrenadeProjectile">
		<defName>Grenade_ExtinguisherPack</defName>
		<label>extinguisher pack capsule</label>
		<thingClass>ExtinguisherDronePack.Projectile_ExtinguisherPack</thingClass>
		<uiIconPath>Things/Pawn/Drone/ExtinguisherDrone/ExtinguisherDrone_east</uiIconPath>
		<graphicData>
			<texPath>Things/Projectile/Projectile_HunterDrone</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
			<speed>41</speed>
			<spawnsPawnKind>Drone_FirefoamPopper</spawnsPawnKind>
			<tryAdjacentFreeSpaces>true</tryAdjacentFreeSpaces>
		</projectile>
	</ThingDef>

</Defs>
